#!/bin/bash
# Convert to HLG, then let macOS derive and encode real Dolby Vision 8.4 metadata.
set -euo pipefail
export LC_ALL=C

fail() { printf '%s\n' "$*" >&2; exit 1; }
[[ $# == 3 ]] || fail 'Utilisation : hdr-dolby source sortie.mov intensite_0_a_1'
source_file=$1
output_file=$2
strength=$3
[[ -f "$source_file" && -r "$source_file" ]] || fail 'La vidéo source est introuvable ou illisible.'
[[ "$output_file" == *.[mM][oO][vV] ]] || fail 'La sortie Dolby Vision doit porter l’extension .mov.'
[[ $source_file = /* ]] || source_file="$PWD/$source_file"
[[ $output_file = /* ]] || output_file="$PWD/$output_file"
[[ ! -e "$output_file" && ! -L "$output_file" ]] || fail 'Un fichier portant ce nom existe déjà.'

export PATH="${PATH:-/usr/bin:/bin}:/opt/homebrew/bin:/usr/local/bin"
resources="$(cd "$(dirname "$0")" && pwd -P)"
hdr_video="$resources/hdr-video"
apple=${HDR_DOLBY_APPLE:-"$resources/../MacOS/hdr-dolby-apple"}
ffprobe=${HDR_FFPROBE:-$(command -v ffprobe || true)}
[[ -x "$apple" && -x "$hdr_video" ]] || fail 'Le moteur Dolby Vision est introuvable. Réinstalle HDR Studio.'
[[ -x "$ffprobe" ]] || fail 'Installe FFmpeg (Homebrew : brew install ffmpeg), puis réessaie.'

# Stage on the output volume and publish only after all Dolby checks pass.
work=$(/usr/bin/mktemp -d /tmp/hdr-dolby.XXXXXXXX) || fail 'Impossible de préparer l’export Dolby Vision.'
stage= child= meter=
cleanup() {
    [[ -z "$stage" ]] || /bin/rm -rf -- "$stage"
    /bin/rm -rf -- "$work"
}
cancel() {
    if [[ -n "$child" ]]; then
        kill -TERM "$child" 2>/dev/null || true
        wait "$child" 2>/dev/null || true
    fi
    if [[ -n "$meter" ]]; then
        kill -TERM "$meter" 2>/dev/null || true
        wait "$meter" 2>/dev/null || true
    fi
    exit "$1"
}
trap cleanup EXIT
trap 'cancel 143' TERM
trap 'cancel 130' INT
stage=$(/usr/bin/mktemp -d "${output_file%/*}/.hdr-dolby.XXXXXXXX") || fail 'Impossible d’écrire dans le dossier de sortie.'

# Give the app a fixed 0..1,000,000 range while mapping progress of both passes.
# Forward TERM to the active process; the HLG shell in turn stops its encoder.
printf 'duration_us=1000000\n'
run_stage() {
    local name=$1 from=$2 span=$3 rc=0
    shift 3
    local fifo="$work/$name.progress"
    /usr/bin/mkfifo "$fifo" || return
    /usr/bin/awk -F= -v from="$from" -v span="$span" '
        $1=="duration_us" && $2+0>0 {d=$2+0}
        $1=="out_time_us" && $2~/^[0-9]+$/ && d>0 {
            f=$2/d
            if (f>1) f=1
            printf "out_time_us=%.0f\n",from+span*f
            fflush()
        }
    ' <"$fifo" & meter=$!
    "$@" >"$fifo" & child=$!
    wait "$child" || rc=$?
    child=
    wait "$meter" || true
    meter=
    return "$rc"
}
# ProRes avoids an unnecessary HEVC generation before Apple's HEVC encoder.
run_stage hlg 0 550000 /usr/bin/env HDR_VIDEO_INTERMEDIATE=prores \
    "$hdr_video" "$source_file" "$stage/base.mov" hlg "$strength" ||
    fail 'Impossible de préparer la vidéo de base HLG.'
printf 'out_time_us=550000\n'
run_stage dolby 550000 425000 "$apple" "$stage/base.mov" "$stage/result.mov" ||
    fail 'Le Mac n’a pas pu encoder cette vidéo en Dolby Vision.'
printf 'out_time_us=975000\n'

details=$("$ffprobe" -v error -select_streams V:0 -show_entries \
    'stream=codec_name,codec_tag_string,profile,pix_fmt,color_primaries,color_transfer,color_space:stream_side_data=dv_profile,dv_bl_signal_compatibility_id,rpu_present_flag,bl_present_flag,el_present_flag,side_data_type' \
    -of default=nw=1 "$stage/result.mov") || fail 'Impossible de vérifier la vidéo Dolby Vision.'
for field in 'codec_name=hevc' 'codec_tag_string=hvc1' 'profile=Main 10' 'pix_fmt=yuv420p10le' \
    'color_primaries=bt2020' 'color_transfer=arib-std-b67' 'color_space=bt2020nc' \
    'dv_profile=8' 'dv_bl_signal_compatibility_id=4' 'rpu_present_flag=1' 'bl_present_flag=1' 'el_present_flag=0' \
    'side_data_type=Ambient viewing environment'; do
    /usr/bin/grep -Fxq -- "$field" <<< "$details" ||
        fail "La vidéo produite ne correspond pas au profil Dolby Vision 8.4 attendu ($field)."
done

# A stream-level label alone is insufficient. Decode the first packets to check
# VideoToolbox actually wrote and FFmpeg can parse frame-level Dolby metadata.
frames=$("$ffprobe" -v error -select_streams V:0 -read_intervals '%+#24' \
    -show_entries frame=pts:frame_side_data=side_data_type -of default=nw=1 "$stage/result.mov") ||
    fail 'Impossible de vérifier les métadonnées Dolby Vision dans les images.'
/usr/bin/grep -Fxq 'side_data_type=Dolby Vision RPU Data' <<< "$frames" &&
    /usr/bin/grep -Fxq 'side_data_type=Dolby Vision Metadata' <<< "$frames" ||
    fail 'Les métadonnées dynamiques Dolby Vision sont absentes de la vidéo.'

/bin/mv -n -- "$stage/result.mov" "$output_file" || fail 'Impossible d’enregistrer la vidéo Dolby Vision.'
[[ ! -e "$stage/result.mov" ]] || fail 'Un fichier portant ce nom existe déjà.'
printf 'out_time_us=1000000\nprogress=end\n'
